<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fdu.cloudnative.api.mapper.ReservationMapper">

    <!-- 公共片段 1：要查的列 -->
    <sql id="baseColumns">
        r.id, r.venue_id, v.name AS venue_name, r.booker_name,
        r.reservation_date, r.start_time, r.end_time, r.purpose, r.status
    </sql>

    <!-- 公共片段 2：表与 JOIN -->
    <sql id="baseFrom">
        FROM reservations r
        JOIN venues v ON v.id = r.venue_id
    </sql>

    <!-- 公共片段 3：可选的筛选条件 -->
    <sql id="filters">
        <where>
            <if test="venueId != null">AND r.venue_id = #{venueId}</if>
            <if test="reservationDate != null">AND r.reservation_date = #{reservationDate}</if>
            <if test="status != null and status != ''">AND r.status = #{status}</if>
        </where>
    </sql>

    <select id="getReservationById" resultType="com.fdu.cloudnative.api.vo.ReservationVO">
        SELECT <include refid="baseColumns"/>
        <include refid="baseFrom"/>
        WHERE r.id = #{id}
    </select>

    <select id="selectPage" resultType="com.fdu.cloudnative.api.vo.ReservationVO">
        SELECT <include refid="baseColumns"/>
        <include refid="baseFrom"/>
        <include refid="filters"/>
        ORDER BY r.reservation_date, r.start_time, r.id
        LIMIT #{pageSize} OFFSET #{offset}
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*)
        <include refid="baseFrom"/>
        <include refid="filters"/>
    </select>
</mapper>
